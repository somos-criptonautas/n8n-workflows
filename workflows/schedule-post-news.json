    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($input.item.json.message?.content) {\n  const raw = $input.item.json.message.content\n    .trim()\n    .replace(/(\\r\\n|\\n|\\r)/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .slice(0, 8500)\n\n  try {\n    const parsed = JSON.parse(raw)\n    $input.item.json.titulo = parsed.titulo || ''\n    $input.item.json.contenido = parsed.contenido || ''\n  } catch (e) {\n    $input.item.json.titulo = 'Error parseando contenido'\n    $input.item.json.contenido = raw\n  }\n}\n\nreturn $input.item"
      },
