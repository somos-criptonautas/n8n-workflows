              },
              {
                "id": "stats",
                "name": "stats",
                "value": "={{ (() => { const MIN_N = 5; const shape = JSON.parse($('Recorrer quizzes').item.json.shape || '[]'); const q = shape.map((k) => Array(k).fill(0)); let n = 0; for (const it of $input.all()) { for (const kv of (it.json.key_values || [])) { if (kv.key !== 'r') continue; let a; try { a = JSON.parse(kv.value).a; } catch (e) { continue; } if (!Array.isArray(a) || a.length !== q.length || !a.every((v, i) => Number.isInteger(v) && v >= 0 && v < q[i].length)) continue; a.forEach((v, i) => q[i][v]++); n++; } } return n >= MIN_N ? JSON.stringify({ n, q }) : ''; })() }}",
                "type": "string"
              }
            ]
          }
        },
