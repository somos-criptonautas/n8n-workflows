      {
        "id": "a5e276d5-5cb5-4b62-a169-546b6516e666",
        "name": "topics-from-lists",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          0
        ],
        "parameters": {
          "jsCode": "const seen = new Set();\nconst out = [];\nfor (const page of $input.all()) {\n  for (const t of page.json.topic_list?.topics ?? []) {\n    if (seen.has(t.id)) continue;\n    seen.add(t.id);\n    out.push({ json: t });\n  }\n}\nreturn out;"
        }
