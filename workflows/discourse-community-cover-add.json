      "parameters": {
        "jsCode": "return $input.all().filter(i => i.json.body?.topic?.id).map(i => ({ json: i.json.body.topic }));"
      }
    },
    {
      "id": "c6fff75d-0b5b-4f7c-aec5-c9c4c677315c",
      "name": "pick-label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "jsCode": "// curso (41) and glosario (15) win over the wiki tag; subcategories of curso are left out\n// curso always gets the cover so its og:image stays uniform, even when the post already has images\nconst out = [];\nfor (const item of $input.all()) {\n  const t = item.json;\n  const tags = (t.tags ?? []).map(tag => typeof tag === 'string' ? tag : tag.name);\n  const label = t.category_id === 41 ? 'Curso' : t.category_id === 15 ? 'Glosario' : tags.includes('wiki') ? 'Wiki' : '';\n  if (t.id && t.title && label && (label === 'Curso' || !t.image_url)) out.push({ json: { topic_id: t.id, title: t.title, label } });\n}\nreturn out;"
      }
    },
