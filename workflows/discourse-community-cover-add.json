        0
      ],
      "parameters": {
        "jsCode": "// curso without its subcategories, all of glosario, and every topic tagged wiki\nreturn ['/c/41/l/latest.json?no_subcategories=true', '/c/15/l/latest.json', '/tag/wiki/l/latest.json'].map(path => ({ json: { path } }));"
      }
    },
