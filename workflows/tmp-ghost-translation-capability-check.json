        "jsCode": "const mods = ['cheerio','node-html-parser','htmlparser2','parse5','jsdom','linkedom','crypto'];\nconst modules = {};\nfor (const m of mods) {\n  try { require(m); modules[m] = 'allowed'; } catch (e) { modules[m] = 'blocked: ' + String(e.message).slice(0, 90); }\n}\nlet env = 'blocked';\ntry { env = { ghost_admin_url_set: typeof $env.GHOST_ADMIN_URL === 'string' && $env.GHOST_ADMIN_URL.length > 0, ghost_webhook_secret_set: typeof $env.GHOST_WEBHOOK_SECRET === 'string' && $env.GHOST_WEBHOOK_SECRET.length > 0 }; } catch (e) { env = 'blocked: ' + String(e.message).slice(0, 90); }\nconst sample = '<figure class=\"kg-card kg-image-card kg-width-wide\"><img src=\"https://criptonautas.co/content/images/2026/10/retoswap-interface.png\" class=\"kg-image\" alt=\"Interfaz de RetoSwap\" loading=\"lazy\" width=\"2000\" height=\"1315\"><figcaption>Esta es una prueba breve</figcaption></figure>';\nreturn [{ json: { modules, env, sample } }];"
