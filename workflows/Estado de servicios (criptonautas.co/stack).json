      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Lo que ve un miembro: la página de estado en /stack los muestra en este orden.\nreturn [\n  { name: 'Blog', url: 'https://criptonautas.co/' },\n  { name: 'Comunidad', url: 'https://comunidad.criptonautas.co/srv/status' },\n  { name: 'Videos', url: 'https://videos.criptonautas.co/api/v1/config' },\n  { name: 'Soporte', url: 'https://soporte.criptonautas.co/' },\n  { name: 'Formularios', url: 'https://forms.criptonautas.co/' },\n  { name: 'Reuniones', url: 'https://meet.criptonautas.co/' },\n  { name: 'BTCPay · abonos y donaciones', url: 'https://pay.criptonautas.co/api/v1/health' }\n].map(function (s) { return { json: s }; });"
      }
    },
    {
      "id": "a0933ab0-982c-48f6-8751-7cad8478a9a1",
      "name": "Consultar servicio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
