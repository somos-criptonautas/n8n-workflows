    {
      "id": "f44b3657-ac57-44c6-acbd-841542637782",
      "name": "Guardar estado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        128
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Una respuesta por servicio, en el mismo orden. Arriba = respondió con un código menor a 500;\n// un error de red o de tiempo deja el código en 0. Se guarda solo el último chequeo.\nconst services = $('Servicios').all().map(function (i) { return i.json; });\nconst results = $input.all().map(function (item, i) {\n  const j = item.json || {};\n  const code = Number(j.statusCode || (j.error && (j.error.httpCode || j.error.status)) || 0) || 0;\n  const s = services[i] || {};\n  return { name: s.name, url: s.url, ok: code > 0 && code < 500, code: code };\n});\nconst data = $getWorkflowStaticData('global');\ndata.last = { checkedAt: new Date().toISOString(), services: results };\nreturn [{ json: data.last }];"
      }
    },
    {
      "id": "02afbce9-0105-421a-8fec-5219cadc8010",
