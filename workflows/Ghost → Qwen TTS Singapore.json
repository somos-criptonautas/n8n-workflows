    {
      "id": "e2a67582-3a07-46c9-9aec-283efb74bc95",
      "name": "Process Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "jsCode": "const articles = $input.all();\nconst processed = [];\n\nfor (const article of articles) {\n  const cleanText = article.json.html\n    .replace(/<script\\\\b[^<]*(?:(?!<\\\\/script>)<[^<]*)*<\\\\/script>/gi, '')\n    .replace(/<style\\\\b[^<]*(?:(?!<\\\\/style>)<[^<]*)*<\\\\/style>/gi, '')\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/\\\\s+/g, ' ')\n    .trim();\n  \n  const chunks = smartChunk(cleanText, 2000);\n  \n  processed.push({\n    json: {\n      id: article.json.id,\n      title: article.json.title,\n      slug: article.json.slug,\n      url: article.json.url,\n      chunks: chunks,\n      totalChunks: chunks.length,\n      publishedAt: article.json.published_at\n    }\n  });\n}\n\nfunction smartChunk(text, maxLength) {\n  const sentences = text.match(/[^.!?]+[.!?]+[\"']?\\s*/g) || [text];\n  const chunks = [];\n  let currentChunk = '';\n  \n  for (const sentence of sentences) {\n    if ((currentChunk + sentence).length > maxLength && currentChunk.length > 0) {\n      chunks.push(currentChunk.trim());\n      currentChunk = sentence;\n    } else {\n      currentChunk += sentence;\n    }\n  }\n  \n  if (currentChunk.trim()) {\n    chunks.push(currentChunk.trim());\n  }\n  \n  return chunks;\n}\n\nreturn processed;"
      }
    },
    {
