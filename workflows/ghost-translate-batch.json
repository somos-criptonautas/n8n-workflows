      {
        "id": "c856a70a-088e-4126-bf9a-db1e512f157f",
        "name": "Summary",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1792,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const planned = $('Plan Run').all().map((i) => i.json);\n// One entry per planned post: Report can run once per branch, and a crashed node passes its input through.\nconst byPost = new Map();\nfor (const i of $('Translate One').all()) {\n  const n = i.pairedItem?.item ?? 0;\n  if (!byPost.has(n)) byPost.set(n, { ...i.json, slug: i.json.slug || planned[n].slug });\n}\nconst done = [...byPost.values()];\nconst isFailed = (j) => Boolean(j.error) || (!('jobs' in j) && !j.skipped);\nconst failed = done.filter(isFailed);\nconst sum = (k) => done.reduce((a, j) => a + (j[k] || 0), 0);\nconst before = $('Usage Before').first().json.character_count;\nconst after = $('Usage After').first().json.character_count;\nreturn [{ json: { done: done.filter((j) => !isFailed(j) && !j.skipped).length, skipped: done.filter((j) => j.skipped).map((j) => j.slug), failed: failed.length, failed_slugs: failed.map((j) => j.slug), jobs: sum('jobs'), chars_sent: sum('chars_sent'), kept: sum('kept'), deepl_billed: after - before, usage_after: after, usage_limit: $('Usage After').first().json.character_limit, items: done } }];"
        },
        "notes": "Why Code: totals over all items plus a usage difference."
      },
