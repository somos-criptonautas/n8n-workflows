      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = $('Settings').first().json;\nconst pick = (node, key, type) => $(node).first().json[key].map((p) => ({ type, id: p.id, slug: p.slug }));\nlet rows = [...pick('List Posts', 'posts', 'posts'), ...pick('List Pages', 'pages', 'pages')];\nif (s.only_slug) rows = rows.filter((r) => r.slug === s.only_slug);\nif (s.limit > 0) rows = rows.slice(0, s.limit);\nreturn rows.map((json) => ({ json }));"
      },
      "notes": "Why Code: merges two API lists and applies two optional filters."
    },
