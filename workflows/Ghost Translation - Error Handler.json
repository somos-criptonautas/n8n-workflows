      "id": "bc893bd9-e596-4380-bb4c-e4ed55849eb3",
      "name": "Format Error Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const execution = $input.first().json.execution;\nconst workflowData = $input.first().json.workflow;\n\nconst errorMessage = execution.error?.message || 'Unknown error';\nconst errorName = execution.error?.name || 'Unknown';\nconst failedNode = execution.lastNodeExecuted || 'Unknown';\nconst timestamp = execution.error?.timestamp ? new Date(execution.error.timestamp).toISOString() : new Date().toISOString();\nconst executionUrl = execution.url || 'N/A';\n\nreturn [{\n  json: {\n    subject: 'Ghost Translation Workflow Failed',\n    workflowName: workflowData.name,\n    workflowId: workflowData.id,\n    failedNode,\n    errorName,\n    errorMessage,\n    timestamp,\n    executionUrl,\n    body: [\n      'Ghost Translation Workflow - Error Report',\n      '',\n      'Workflow: ' + workflowData.name + ' (ID: ' + workflowData.id + ')',\n      'Failed Node: ' + failedNode,\n      'Error: ' + errorName + ' - ' + errorMessage,\n      'Time: ' + timestamp,\n      'Execution: ' + executionUrl,\n      '',\n      'Please check the workflow execution for details.'\n    ].join('\\n')\n  }\n}];"
      }
    },
    {
