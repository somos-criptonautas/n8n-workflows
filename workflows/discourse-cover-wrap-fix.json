      "parameters": {
        "jsCode": "return $input.all().map(i => {\n  const raw = i.json.raw.replace(/\\n*!\\[cover\\|1200x630(?:\\|thumbnail)?\\]\\((upload:\\/\\/[^)]+)\\)\\s*$/, '\\n\\n[wrap=cover]\\n![cover|1200x630|thumbnail]($1)\\n[/wrap]');\n  if (raw === i.json.raw) throw new Error('cover line not found in post ' + i.json.id);\n  return { json: { id: i.json.id, raw } };\n});"
      }
    },
