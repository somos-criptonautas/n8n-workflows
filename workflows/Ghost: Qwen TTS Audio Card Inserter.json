          ]
        }
      }
    },
    {
      "id": "0198f72f-4df4-4a3a-8e5d-f54ea0b34367",
      "name": "Ghost: Get Post",
      "type": "n8n-nodes-base.ghost",
      "typeVersion": 1,
      "position": [
        500,
        400
      ],
      "parameters": {
        "resource": "post",
        "operation": "get",
        "source": "adminApi",
        "by": "slug",
        "identifier": "={{ $json.slug }}",
        "options": {
          "formats": [
            "html"
          ]
        }
      },
      "credentials": {
        "ghostAdminApi": {
          "id": "1A8x4AjzoI4VhxKp",
          "name": "Ghost Admin Account"
        }
      }
    },
    {
      "id": "2e598927-fffc-4009-9ef6-ad11b0d64eab",
      "name": "Check Audio & Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const post = $input.first().json;\nconst html = post.html || '';\n\n// Skip if audio card already exists\nif (html.includes('<audio')) {\n  return [];\n}\n\n// Strip HTML tags for TTS input\nlet text = html\n  .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// TTS max input length is 4096 chars\nif (text.length > 4000) {\n  text = text.substring(0, 4000);\n}\n\nreturn [{\n  json: {\n    text,\n    postId: post.id,\n    postSlug: post.slug,\n    postTitle: post.title,\n    originalHtml: html\n  }\n}];"
      }
    },
    {
      "id": "1a995416-1969-4eb1-b729-6375290fab4c",
      "name": "Qwen: Generate Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.QWEN_TTS_BASE_URL }}/v1/audio/speech",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": $env.QWEN_TTS_MODEL || \"qwen-tts\", \"input\": $json.text, \"voice\": \"alloy\", \"response_format\": \"mp3\" } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            },
            "timeout": 120000
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "08f07a87-627c-402b-bbdf-a4f537dc0d9f",
      "name": "Bunny CDN: Upload Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1250,
        400
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ \"https://storage.bunnycdn.com/\" + ($env.BUNNY_PULL_ZONE || \"your-pull-zone\") + \"/\" + $(\"Check Audio & Extract Text\").item.json.postSlug + \"-audio.mp3\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 60000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "17bf914b-30de-41ef-844a-dcbaecf2ea4e",
      "name": "Build Audio Card & New Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const postSlug = $('Check Audio & Extract Text').item.json.postSlug;\nconst postId = $('Check Audio & Extract Text').item.json.postId;\nconst originalHtml = $('Check Audio & Extract Text').item.json.originalHtml;\n\nconst pullZone = $env.BUNNY_PULL_ZONE || 'your-pull-zone';\nconst audioUrl = 'https://' + pullZone + '.bunnycdn.com/' + postSlug + '-audio.mp3';\n\nconst audioCard = '<figure class=\"kg-embed-card\"><audio controls src=\"' + audioUrl + '\"></audio><figcaption>Listen to this article</figcaption></figure><p></p>';\n\nconst newContent = audioCard + originalHtml;\n\nreturn [{\n  json: {\n    postId,\n    newContent\n  }\n}];"
      }
    },
    {
      "id": "360edafc-7cf1-4077-8915-b3382c13fc04",
      "name": "Ghost: Update Post",
      "type": "n8n-nodes-base.ghost",
      "typeVersion": 1,
      "position": [
        1750,
        400
      ],
      "parameters": {
        "resource": "post",
        "operation": "update",
        "source": "adminApi",
        "postId": "={{ $json.postId }}",
        "contentFormat": "html",
        "updateFields": {
          "content": "={{ $json.newContent }}"
        }
      },
      "credentials": {
        "ghostAdminApi": {
          "id": "1A8x4AjzoI4VhxKp",
          "name": "Ghost Admin Account"
        }
      }
    },
