        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { model: $('Settings').first().json.model, temperature: 0.3, messages: [ { role: 'system', content: 'Resumí el artículo que te pasan en 3 o 4 oraciones, en el mismo idioma del artículo. Solo lo que dice el artículo: sin opiniones, sin adornos, sin repetir el título, sin mencionar comentarios ni lectores. Respondé solo con JSON: {\"lang\":\"es\" o \"en\",\"summary\":\"...\"}' }, { role: 'user', content: $json.text } ] } }}",
        "options": {
          "timeout": 120000
        }
      },
