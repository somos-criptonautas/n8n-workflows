    {
      "id": "d82bc9d4-9e23-4d8d-a00e-07fd1912787a",
      "name": "Write Summary Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Settings').first().json;\nconst raw = $('LLM Summary').first().json.choices[0].message.content;\nconst out = JSON.parse(String(raw).replace(/^\\s*```(?:json)?\\s*|\\s*```\\s*$/g, ''));\nif (!out.summary || !String(out.summary).trim()) throw new Error('The model returned no summary');\n\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst plain = h => String(h || '').replace(/<[^>]+>/g, '').trim();\nconst isSummary = n => n.type === 'toggle' && [cfg.headingEs, cfg.headingEn].includes(plain(n.heading));\n\nconst post = $input.first().json.posts[0];\nconst lexical = JSON.parse(post.lexical);\nconst root = lexical.root.children;\nconst heading = out.lang === 'en' ? cfg.headingEn : cfg.headingEs;\nconst card = { type: 'toggle', version: 1, heading: '<span>' + esc(heading) + '</span>', content: '<p>' + esc(String(out.summary).trim()) + '</p>' };\nconst at = root.findIndex(isSummary);\nif (at < 0) root.unshift(card); else root[at] = card;\n\n// updated_at comes from a fresh read, so edits made while the model ran are kept, not overwritten\nconst update = { lexical: JSON.stringify(lexical), updated_at: post.updated_at };\nif (post.tags.some(t => t.slug === 'hash-resumen-refresh')) update.tags = post.tags.filter(t => t.slug !== 'hash-resumen-refresh').map(t => ({ id: t.id }));\nreturn [{ json: { id: post.id, body: { posts: [update] } } }];\n"
      }
    },
