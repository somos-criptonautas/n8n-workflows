    {
      "id": "ccbec5f7-9de0-40ac-ae0d-0a2c53dd7ae1",
      "name": "Plan Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Settings').first().json;\nconst post = $input.first().json.posts[0];\nconst tags = post.tags.map(t => t.slug);\nif (!tags.includes('hash-resumen')) return [];\nif (post.status !== 'published' && cfg.event !== 'manual') return [];\nconst refresh = tags.includes('hash-resumen-refresh');\n\n// The summary card is the toggle whose heading is exactly one of the two labels\nconst plain = h => String(h || '').replace(/<[^>]+>/g, '').trim();\nconst isSummary = n => n.type === 'toggle' && [cfg.headingEs, cfg.headingEn].includes(plain(n.heading));\nconst lexical = JSON.parse(post.lexical);\nif (lexical.root.children.some(isSummary) && !refresh) return [];\n\n// Article text only: the summary card itself and the audio card are left out\nconst textOf = n => isSummary(n) || n.type === 'audio' ? '' : typeof n.text === 'string' ? n.text : (n.children || []).map(textOf).join(['root', 'list'].includes(n.type) ? '\\n' : '');\nconst text = (post.title + '.\\n' + textOf(lexical.root)).replace(/[ \\t]+/g, ' ').replace(/\\s*\\n\\s*/g, '\\n').trim().slice(0, cfg.maxChars);\nreturn [{ json: { text } }];\n"
      }
    },
    {
      "id": "2907f211-142e-42fd-9f43-f75c59dd4745",
      "name": "LLM Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1024,
        224
