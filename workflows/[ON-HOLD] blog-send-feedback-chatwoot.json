    {
      "parameters": {
        "jsCode": "const cfg = $('Settings').first().json;\nconst b = $('Feedback Webhook').first().json.body || {};\n\n// Honeypot: a field hidden from people that only bots fill in\nif (b.website) return [];\nconst labels = { idea: 'idea', error: 'error', soporte: 'soporte' };\nconst type = labels[b.type];\nif (!type) return [];\nconst message = String(b.message || '').trim();\nif (message.length < 3 || message.length > 3000) return [];\nconst email = String(b.email || '').trim().slice(0, 200);\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return [];\n\nlet page = '';\ntry {\n  const u = new URL(String(b.page || ''));\n  if (u.hostname === 'criptonautas.co' || u.hostname.endsWith('.criptonautas.co')) page = u.href.slice(0, 500);\n} catch (e) {}\n\n// Global cap per minute; static data only persists in production runs\nconst state = $getWorkflowStaticData('global');\nconst minute = Math.floor(Date.now() / 60000);\nif (state.minute !== minute) { state.minute = minute; state.count = 0; }\nstate.count += 1;\nif (state.count > cfg.perMinute) return [];\n\nconst item = {\n  json: {\n    content: '[' + type + '] ' + message + (page ? '\\n\\npágina: ' + page : ''),\n    contact: email ? { name: email.split('@')[0], email } : { name: 'lector anónimo' },\n    hasShot: false\n  }\n};\n\nconst m = /^data:image\\/(png|jpeg|webp);base64,([A-Za-z0-9+/=]+)$/.exec(String(b.screenshot || ''));\nif (m && m[2].length * 0.75 <= cfg.maxShotBytes) {\n  const ext = m[1] === 'jpeg' ? 'jpg' : m[1];\n  item.binary = { screenshot: { data: m[2], mimeType: 'image/' + m[1], fileName: 'captura.' + ext } };\n  item.json.hasShot = true;\n}\nreturn [item];\n"
      },
