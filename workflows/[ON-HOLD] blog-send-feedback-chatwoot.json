      ]
    },
    {
      "parameters": {
        "jsCode": "const v = $('Validate').first();\nconst cfg = $('Settings').first().json;\nconst base = cfg.chatwootUrl + '/public/api/v1/inboxes/' + cfg.inboxIdentifier + '/contacts/' + $('Create Contact').first().json.source_id + '/conversations/' + $input.first().json.id + '/messages';\n// The screenshot travels on from Validate; the HTTP calls in between replaced the item\nreturn [{ json: { url: base, content: v.json.content, hasShot: v.json.hasShot }, binary: v.binary }];\n"
      },
