    {
      "id": "98d76878-280a-429c-946e-dc8106bdb754",
      "name": "Write Audio Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Settings').first().json;\nconst plan = $('Plan Audio').first().json;\nconst post = $input.first().json.posts[0];\nconst lexical = JSON.parse(post.lexical);\nconst root = lexical.root.children;\nconst at = root.findIndex(n => n.type === 'audio' && String(n.src).startsWith(cfg.cdnBase));\n\nif (plan.action === 'stale') {\n  if (at < 0) return [];\n  root[at].title = plan.title;\n} else {\n  const audio = $('Join Audio').first().json;\n  const card = { type: 'audio', version: 1, src: `${cfg.cdnBase}/${cfg.audioDir}/${audio.fileName}`, title: plan.title, duration: audio.duration, mimeType: 'audio/mpeg', thumbnailSrc: '' };\n  if (at < 0) root.unshift(card); else root[at] = card;\n}\n\n// updated_at comes from a fresh read, so edits made while audio was generating are kept, not overwritten\nconst update = { lexical: JSON.stringify(lexical), updated_at: post.updated_at };\nif (post.tags.some(t => t.slug === 'hash-audio-refresh')) update.tags = post.tags.filter(t => t.slug !== 'hash-audio-refresh').map(t => ({ id: t.id }));\nreturn [{ json: { id: post.id, body: { posts: [update] } } }];\n"
      }
    },
