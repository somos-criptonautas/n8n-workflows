    },
    {
      "id": "7cdb9f92-4f2f-4687-b6fc-2f3d4c4924fa",
      "name": "Join Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -120
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst parts = [];\nfor (let i = 0; i < items.length; i++) parts.push(await this.helpers.getBinaryDataBuffer(i, 'data'));\n// MP3 is frame-based, so byte-joining the chunks plays as one file\nconst audio = Buffer.concat(parts);\n\n// Duration from the first frame's bitrate; assumes constant bitrate, which TTS output is\nlet i = 0;\nwhile (i < audio.length - 2 && !(audio[i] === 0xff && (audio[i + 1] & 0xe0) === 0xe0)) i++;\nconst mpeg1 = ((audio[i + 1] >> 3) & 3) === 3;\nconst kbps = (mpeg1 ? [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320] : [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160])[audio[i + 2] >> 4] || 0;\nconst duration = kbps ? Math.round((audio.length * 8) / (kbps * 1000)) : 0;\n\nconst fileName = $('Plan Audio').first().json.fileName;\nreturn [{ json: { fileName, duration }, binary: { data: await this.helpers.prepareBinaryData(audio, fileName, 'audio/mpeg') } }];\n"
      }
    },
