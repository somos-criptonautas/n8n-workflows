    {
      "id": "b902f859-3893-42ff-b341-14235028e2a2",
      "name": "Plan Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Settings').first().json;\nconst post = $input.first().json.posts[0];\nconst tags = post.tags.map(t => t.slug);\nif (!tags.includes('hash-audio')) return [];\nif (post.status !== 'published' && cfg.event !== 'manual') return [];\nconst refresh = tags.includes('hash-audio-refresh');\n\n// Read text from lexical so the inserted audio card never changes the fingerprint; code blocks and images are skipped on purpose\n// The AI summary toggle (\"resumen\"/\"summary\", from Ghost: AI Summary Card) is skipped too, so adding it does not mark the audio stale\nconst isSummary = n => n.type === 'toggle' && ['resumen', 'summary'].includes(String(n.heading || '').replace(/<[^>]+>/g, '').trim());\nconst textOf = n => n.type === 'audio' || isSummary(n) ? '' : typeof n.text === 'string' ? n.text : (n.children || []).map(textOf).join(['root', 'list'].includes(n.type) ? '\\n' : '');\nconst lexical = JSON.parse(post.lexical);\nconst text = (post.title + '.\\n' + textOf(lexical.root)).replace(/[ \\t]+/g, ' ').replace(/\\s*\\n\\s*/g, '\\n').trim();\n\n// djb2 fingerprint: detects text changes, not a security hash\nlet h = 5381;\nfor (const c of text) h = ((h * 33) ^ c.charCodeAt(0)) >>> 0;\nconst fileName = `${post.slug}-${h.toString(16).padStart(8, '0')}.mp3`;\n\nconst lang = /-es$/.test(post.slug) || tags.includes('hash-lang-es') ? 'es' : 'en';\nconst card = lexical.root.children.find(n => n.type === 'audio' && String(n.src).startsWith(cfg.cdnBase));\nif (card && card.src.endsWith('/' + fileName)) return [];\nif (card && !refresh) {\n  const stale = lang === 'es' ? cfg.staleEs : cfg.staleEn;\n  return card.title === stale ? [] : [{ json: { action: 'stale', title: stale } }];\n}\nif (!card && !refresh && !['published', 'manual'].includes(cfg.event)) return [];\n\n// shortcut: a single sentence longer than chunkChars is sent whole; split on commas if the TTS endpoint rejects it\nconst chunks = [];\nlet cur = '';\nfor (const s of text.match(/[^.!?…]+(?:[.!?…]+[\"'»”)]*|$)\\s*/g)) {\n  if (cur && (cur + s).length > cfg.chunkChars) { chunks.push(cur.trim()); cur = ''; }\n  cur += s;\n}\nif (cur.trim()) chunks.push(cur.trim());\n\nconst voice = lang === 'es' ? cfg.voiceEs : cfg.voiceEn;\nconst title = lang === 'es' ? cfg.titleEs : cfg.titleEn;\nreturn chunks.map(chunk => ({ json: { action: 'generate', text: chunk, voice, title, fileName } }));\n"
      }
    },
