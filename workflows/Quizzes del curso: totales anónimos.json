    {
      "id": "d829cac9-d8c9-4015-8332-91ecc8dfacb5",
      "name": "Sumar respuestas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Con menos de 5 respuestas no se publica nada: los totales podrían delatar a alguien\nconst MIN_N = 5;\nconst quizzes = $('Leer quizzes').all().map((i) => i.json);\nconst rows = quizzes.map(() => []);\nfor (const item of $input.all()) {\n  const p = Array.isArray(item.pairedItem) ? item.pairedItem[0] : item.pairedItem;\n  const idx = p && typeof p.item === 'number' ? p.item : -1;\n  if (!rows[idx]) throw new Error('Página de respuestas sin quiz de origen (pairedItem)');\n  for (const kv of item.json.key_values || []) if (kv.key === 'r') rows[idx].push(kv.value);\n}\nconst out = [];\nquizzes.forEach((quiz, idx) => {\n  const shape = JSON.parse(quiz.shape || '[]');\n  const q = shape.map((n) => Array(n).fill(0));\n  let n = 0;\n  for (const raw of rows[idx]) {\n    let a;\n    try { a = JSON.parse(raw).a; } catch (e) { continue; }\n    // Respuestas de una versión vieja del quiz o adulteradas no cuentan\n    if (!Array.isArray(a) || a.length !== q.length || !a.every((v, i) => Number.isInteger(v) && v >= 0 && v < q[i].length)) continue;\n    a.forEach((v, i) => q[i][v]++);\n    n++;\n  }\n  if (n >= MIN_N) out.push({ json: { artifact_id: quiz.artifact_id, key: quiz.key, n, value: JSON.stringify({ n, q }) }, pairedItem: { item: idx } });\n});\nreturn out;"
      }
    },
