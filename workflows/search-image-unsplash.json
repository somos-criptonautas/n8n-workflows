      "position": [
        480,
        688
      ]
    },
    {
      "parameters": {
        "url": "https://api.unsplash.com/search/photos",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify({ query: $json.prompt, per_page: 3, orientation: \"landscape\" }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept-Version",
              "value": "v1"
            }
          ]
        },
        "options": {
