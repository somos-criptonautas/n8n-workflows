      "id": "3fd1562c-6623-4c63-8456-4869eb73e318",
      "name": "Search Unsplash",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        704,
        672
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst prompt = $('Extract & Clean Prompt').first().json.prompt;\nconst results = data.results || [];\n\nconst unsplashImages = results.slice(0, 3).map((r, i) => ({\n  id: r.id,\n  url: r.urls?.regular || r.urls?.full || r.urls?.small,\n  thumb: r.urls?.thumb || r.urls?.small,\n  alt: r.alt_description || prompt,\n  author: r.user?.name || 'Unknown',\n  authorUrl: r.user?.links?.html || '',\n  downloadUrl: r.links?.download || '',\n  source: 'unsplash',\n  index: i + 1\n}));\n\nconst genPrompts = [\n  prompt,\n  prompt + ' - alternative interpretation',\n  prompt + ' - artistic variation'\n];\n\nreturn genPrompts.map((p, i) => ({\n  json: {\n    generationPrompt: p,\n    unsplashImages,\n    generationIndex: i + 1,\n    totalGenerations: 3\n  }\n}));"
      },
      "id": "a891cac5-b6a8-4343-a39d-4f3a546a003e",
      "name": "Prepare Image Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        464
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENAI_API_BASE || \"https://api.openai.com/v1\" }}/images/generations",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_MODEL || \"dall-e-3\", prompt: $json.generationPrompt, n: 1, size: \"1024x1024\", response_format: \"url\" }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a8a05a04-06ea-4242-ae74-49b1a2cfeb6d",
      "name": "Generate Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1072,
        464
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst prompt = $('Extract & Clean Prompt').first().json.prompt;\n\nconst unsplashImages = items[0]?.json?.unsplashImages || [];\n\nconst generatedImages = items.map((item, i) => {\n  const data = item.json;\n  const imgUrl = data.data?.[0]?.url || data.data?.[0]?.b64_json || null;\n  return {\n    url: imgUrl,\n    prompt: data.generationPrompt || prompt,\n    index: i + 1\n  };\n}).filter(img => img.url);\n\nreturn [{\n  json: {\n    status: 'success',\n    query: prompt,\n    timestamp: new Date().toISOString(),\n    images: {\n      unsplash: unsplashImages,\n      generated: generatedImages\n    },\n    meta: {\n      unsplashCount: unsplashImages.length,\n      generatedCount: generatedImages.length,\n      totalImages: unsplashImages.length + generatedImages.length\n    }\n  }\n}];"
      },
