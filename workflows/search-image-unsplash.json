    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst raw = body.prompt || body.query || body.text || body.search || '';\nconst cleaned = raw.trim().replace(/\\s+/g, ' ');\nif (!cleaned) throw new Error('No prompt provided in webhook body');\nreturn [{ json: { prompt: cleaned, original: raw } }];"
      },
      "id": "7a7a73b3-e643-43f8-a463-5e45a890a298",
      "name": "Extract & Clean Prompt",
      "type": "n8n-nodes-base.code",
