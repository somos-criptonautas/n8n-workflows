      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst webhookSecret = $env.GHOST_WEBHOOK_SECRET;\nconst rawBody = $json.body;\nconst signatureHeader = $json.headers['x-ghost-signature'];\n\nif (!webhookSecret) {\n  throw new Error('GHOST_WEBHOOK_SECRET environment variable is not set');\n}\n\nif (!signatureHeader) {\n  throw new Error('Missing x-ghost-signature header');\n}\n\nconst parts = signatureHeader.split(',').map(p => p.trim());\nconst expectedSig = parts[0].replace('sha256=', '');\nconst timestamp = parts[1].replace('t=', '');\n\nconst hmac = crypto.createHmac('sha256', webhookSecret);\nhmac.update(rawBody);\nhmac.update(timestamp);\nconst computedSig = hmac.digest('hex');\n\nif (computedSig !== expectedSig) {\n  throw new Error('Invalid webhook signature');\n}\n\nreturn $input.all();"
      }
    },
