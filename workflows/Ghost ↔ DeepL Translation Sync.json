      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst sourcePost = $input.first().json.posts[0];\n\nconst title = sourcePost.title || '';\nconst html = sourcePost.html || '';\nconst customExcerpt = sourcePost.custom_excerpt || '';\n\nconst hash = crypto.createHash('sha256');\nhash.update(title + html + customExcerpt);\nconst contentHash = hash.digest('hex');\n\nreturn [{\n  json: {\n    ...sourcePost,\n    contentHash,\n    translationSlug: sourcePost.slug + '-es'\n  }\n}];"
