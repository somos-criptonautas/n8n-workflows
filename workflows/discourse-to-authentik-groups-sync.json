    {
      "parameters": {
        "jsCode": "// Flip ADD_ONLY to false once the seed run looks right: then removals apply too.\n// agoristas and team stay hand-managed in authentik for now; add them back here AND to\n// the Discourse API key's name param when you want them synced.\nconst ADD_ONLY = true;\nconst tiers = ['nuevos', 'anons', 'nautas', 'traders'];\nreturn tiers.map(t => ({ json: { discourseGroup: t, authentikGroup: 'discourse-' + t, addOnly: ADD_ONLY } }));"
      },
