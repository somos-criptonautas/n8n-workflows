      "id": "844f2de9-8147-46e9-ac84-27e165a19cc6",
      "name": "Fetch authentik users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1168,
        128
      ],
      "executeOnce": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "xwLgNCuqccd2SaNl",
          "name": "authentik-discourse-sync"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Discourse tier list').all();\nconst addOnly = cfg[0].json.addOnly;\n\nconst groupsBody = $('Fetch authentik groups').first().json;\nif (groupsBody.pagination.count > groupsBody.results.length) {\n  throw new Error('authentik returned ' + groupsBody.results.length + ' of ' + groupsBody.pagination.count + ' groups; raise page_size on Fetch authentik groups');\n}\nconst groupByName = {};\nfor (const g of groupsBody.results) { groupByName[g.name] = g; }\n\n// username -> pk, across every page of users\nconst pkByUsername = {};\nfor (const page of $('Fetch authentik users').all()) {\n  for (const u of page.json.results) { pkByUsername[u.username] = u.pk; }\n}\n\nconst missing = [];\nfor (const c of cfg) {\n  if (!groupByName[c.json.authentikGroup]) { missing.push(c.json.authentikGroup); }\n}\nif (missing.length) {\n  throw new Error('Missing authentik groups: ' + missing.join(', ') + ' - create them before syncing');\n}\n\nconst ops = [];\nconst noAccount = [];\nfor (const item of $('Tag members with tier').all()) {\n  const tier = item.json.tier;\n  const members = item.json.members || [];\n  const total = item.json.meta ? item.json.meta.total : members.length;\n  // shortcut: single 1000-member page, fail loud instead of silently truncating; add pagination if a tier outgrows it\n  if (total > members.length) {\n    throw new Error(tier + ': Discourse reports ' + total + ' members but returned ' + members.length + '; add pagination to Fetch Discourse members');\n  }\n  const group = groupByName[tier];\n  const want = new Set(members.map(m => m.username));\n  const have = new Set((group.users_obj || []).map(u => u.username));\n\n  for (const username of want) {\n    if (have.has(username)) { continue; }\n    const pk = pkByUsername[username];\n    if (!pk) { noAccount.push(tier + '/' + username); continue; }\n    ops.push({ json: { op: 'add', group: tier, groupUuid: group.pk, username: username, pk: pk } });\n  }\n\n  if (!addOnly) {\n    for (const username of have) {\n      if (want.has(username)) { continue; }\n      ops.push({ json: { op: 'remove', group: tier, groupUuid: group.pk, username: username, pk: pkByUsername[username] } });\n    }\n  }\n}\n\nif (noAccount.length) {\n  console.log('No authentik account, skipped: ' + noAccount.join(', '));\n}\nreturn ops;"
      },
